APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Theme: SSR fallback when OS preference is unknown (cookie `system` or absent). Values: dark | light. Default: dark.
DEFAULT_THEME_MODE=dark
NEXT_PUBLIC_DEFAULT_THEME_MODE=dark

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: internal origin for server-side requests to own API (e.g. in Docker when public hostname is not resolvable).
# Example: APP_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Used for server-side self-fetch (e.g. src/proxy.ts → Content-Signal API). In production/Docker set to the app’s reachable base URL if hostname differs from the browser.
APP_INTERNAL_ORIGIN=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=15724800

# MongoDB — 2 Variants:
# 1) External cluster: set MONGO_URI (full connection string, e.g. Atlas).
# 2) Local container (mongo_enabled: true in deploy): you can set MONGO_URI=mongodb://mongo:27017/app or set separate fields below.
MONGO_URI=
# If MONGO_URI is not set, the string is assembled from the fields below.
# Use mongo when app runs in Docker (same network as mongo container); use localhost for local dev on host.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=app

# Per Second
RATE_LIMIT_POINTS=100

# LOCAL
REDIS_URL=redis://localhost:6380

# https://vapidkeys.com/
VAPID_SUBJECT="mailto:your-email@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# IndexNow (Bing, Yandex, ChatGPT) — ping on publication
INDEXNOW_API_KEY=
INDEXNOW_KEY_LOCATION=

# Google Indexing API (only JobPosting / BroadcastEvent; for articles not used)
# Service Account: client_email and private_key from JSON key (in .env private_key is in one line, \n replace with \\n)
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=

# Auth for the public SEO indexing endpoints (/api/v1/seo/notify|indexnow|google-indexing).
# Gradual rollout:
#   1) Deploy with SEO_NOTIFY_AUTH_ENABLED=false (default) — endpoints stay open, nothing breaks.
#   2) Set SEO_NOTIFY_SECRET and update your callers to send header `x-seo-notify-secret: <value>`.
#   3) Flip SEO_NOTIFY_AUTH_ENABLED=true to enforce. (enabled + empty secret → 503)
SEO_NOTIFY_AUTH_ENABLED=false
SEO_NOTIFY_SECRET=

# MFA (TOTP)
# Use a strong random string; it's used to derive an encryption key for TOTP secrets.
MFA_ENCRYPTION_KEY=

FIRST_ADMIN_LOGIN=
FIRST_ADMIN_PASSWORD=

# Uploadcare Secrets
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# Set automatically by CI/CD pipelines (e.g. GitHub Actions)
COMMIT_HASH=

# RUM (Web Vitals)
RUM_ENABLED=true
NEXT_PUBLIC_RUM_ENABLED=true
# Fraction of page loads that report all vitals (0–1). Not per-request — avoids losing LCP/CLS/INP to random drops.
NEXT_PUBLIC_RUM_SAMPLE_RATE=0.2
# Set `true` only in local/dev to skip the cookie banner and auto-allow RUM (do not use in production).
NEXT_PUBLIC_SKIP_ANALYTICS_CONSENT=false

# i18n
# Supported: en, ru
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Organization Same As as Array of string
NEXT_PUBLIC_ORGANIZATION_SAME_AS=https://www.example.com,https://www.example.com,https://www.example.com
# Example: NEXT_PUBLIC_ORGANIZATION_SAME_AS=https://www.example.com,https://www.example.com,https://www.example.com

LLM_API_KEY=
NEXT_PUBLIC_LLM_ENABLED=true|false
# Optional: comma-separated chat model ids (default: gpt-4o-mini,gpt-4o)
LLM_CHAT_MODELS=gpt-4o-mini,gpt-4o
# GPT Image allowlist for `POST /api/v1/llm/image/generate` (optional; defaults: gpt-image-1-mini,gpt-image-1.5)
LLM_IMAGE_MODELS=gpt-image-1-mini,gpt-image-1.5
# Per-user LLM chat rate limit (points per window)
LLM_CHAT_RATE_LIMIT_POINTS=30
LLM_CHAT_RATE_DURATION_SEC=60

# JSON array: host:port:user:password (optional :geo suffix, ignored for URL). OpenAI calls pick one entry at random per HTTP request when length > 1.
# PROXY_ACCESSES=["1.2.3.4:8080:user:pass:de","5.6.7.8:8080:user2:pass2:us"]
PROXY_ACCESSES=


# Sign-up email OTP (HMAC pepper; falls back to JWT_SECRET if empty)
REGISTRATION_CODE_PEPPER=
# Email or Empty (Empty means sign-up without email OTP)
REGISTRATION_MODE=email
# Transactional email: `console` = log only; `elastic` = Elastic Email API (templates + body).
EMAIL_SEND_MODE=console
EMAIL_API_KEY=
# Required for `elastic`: verified sender, e.g. Noreply <noreply@yourdomain.com>
EMAIL_FROM="Noreply <noreply@localhost>"
# Optional separate reply address
EMAIL_REPLY_TO=
# Elastic template names for sign-up (merge field `code`); EN default, RU for ru / ru-RU locale
EMAIL_TEMPLATE_VERIFY_EMAIL_EN="EN: Verify Email"
EMAIL_TEMPLATE_VERIFY_EMAIL_RU="RU: Verify Email"
EMAIL_TEMPLATE_PASSWORD_CHANGE_EN=
EMAIL_TEMPLATE_PASSWORD_CHANGE_RU=
EMAIL_TEMPLATE_PASSWORD_FORGOT_EN=
EMAIL_TEMPLATE_PASSWORD_FORGOT_RU=

# Platform notifications (1/true/on = enabled; 0/false/off = disabled)
# Channels: `all`, or comma-separated `web_push`, `email`
NOTIFY_ARTICLE_ENABLED=1
NOTIFY_ARTICLE_CHANNELS=all
NOTIFY_MFA_ENABLED=1
NOTIFY_MFA_CHANNELS=all
NOTIFY_LOGIN_ENABLED=1
NOTIFY_LOGIN_CHANNELS=email
NOTIFY_PASSWORD_ENABLED=1
NOTIFY_PASSWORD_CHANNELS=email

# Account security (0=off, 1=on)
AUTH_PASSWORD_CHANGE_ENABLED=1
AUTH_PASSWORD_FORGOT_ENABLED=1
AUTH_RECOVERY_STRICTNESS=strict
AUTH_ADMIN_ACCOUNT_RECOVERY_ENABLED=1
AUTH_SESSIONS_ENABLED=0
ONBOARDING_VERSION=1
ONBOARDING_ENABLED=0
ONBOARDING_PUSH_PROMPT_ENABLED=0
NEXT_PUBLIC_ONBOARDING_ENABLED=0
NEXT_PUBLIC_ONBOARDING_PUSH_PROMPT_ENABLED=0
NEXT_PUBLIC_PUSH_IOS_PWA_HINT_ENABLED=0

# Machine auth: Personal Access Tokens + MCP server (see mcp/README.md, docs/MCP_ARTICLES_SERVER_RU.md)
# API_TOKENS_ENABLED gates /api/v1/api-token/* and PAT auth; NEXT_PUBLIC_* shows /admin/api-tokens and /profile/api-tokens in the nav.
# Non-admin roles issue tokens only when allowed by role policies (admin UI → Role policies).
API_TOKENS_ENABLED=0
NEXT_PUBLIC_API_TOKENS_ENABLED=0
# Name the MCP server reports to hosts (remote /api/mcp and stdio) — brand per project, e.g. quickping-mcp
MCP_SERVER_NAME=nsb-mcp
# Brand for machine identifiers: <brand>_pat_, <brand>_oat_, <brand>_mcp_client_ (e.g. quickping).
# Set once at project bootstrap — changing it later breaks detection of already issued tokens.
NEXT_PUBLIC_API_TOKEN_BRAND=nsb
# OAuth 2.1 layer over /api/mcp for Claude.ai/Desktop custom connectors (discovery, DCR, consent, token, revoke).
# Requires API_TOKENS_ENABLED=1. See docs/MCP_OAUTH_DESIGN_RU.md.
MCP_OAUTH_ENABLED=0
# OAuth access token TTL in minutes (short-lived by design; hosts refresh via refresh_token)
MCP_OAUTH_ACCESS_TTL_MINUTES=60
# Lazy cleanup: DCR clients with no grants and no activity for this many days are deleted
MCP_OAUTH_CLIENT_RETENTION_DAYS=30
# TTL of the machine-access usage time series (admin /admin/machine-access). Set before first deploy;
# changing later requires dropping the ApiTokenUsageEvent createdAt TTL index.
API_TOKEN_USAGE_RETENTION_DAYS=30

# OAuth / social login (see docs/AUTH_OAUTH.md)
# AUTH_UI_MODE: credentials_first | oauth_first | credentials_only | oauth_only
AUTH_UI_MODE=credentials_only
NEXT_PUBLIC_AUTH_UI_MODE=credentials_only
AUTH_OAUTH_SIGN_IN_PROVIDERS=yandex,google,github
AUTH_OAUTH_SIGN_UP_PROVIDERS=yandex,google,github
NEXT_PUBLIC_AUTH_OAUTH_SIGN_IN_PROVIDERS=yandex,google,github
NEXT_PUBLIC_AUTH_OAUTH_SIGN_UP_PROVIDERS=yandex,google,github
AUTH_OAUTH_LINK_PROVIDERS=yandex,google,github
NEXT_PUBLIC_AUTH_OAUTH_LINK_PROVIDERS=yandex,google,github
# Enable providers individually (1/on = enabled)
AUTH_OAUTH_YANDEX_ENABLED=0
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_ENABLED=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_ENABLED=0
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_VK_ENABLED=0
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_DISCORD_ENABLED=0
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
