# Environment template. Every variable is described in docs/configure/env-reference.{ru,en}.md
# (same order as here; `pnpm gates` keeps the two in sync). Validate with `pnpm doctor`.
#   Fresh fork:        ./scripts/init-project.sh   (renames placeholders, generates secrets, once)
#   Repeat onboarding: make setup                  (tops up new keys, fills empty ones, runs doctor)

# ── App & site ────────────────────────────────────────────────────────────────
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side self-fetch origin when the public hostname is not resolvable (Docker).
APP_INTERNAL_ORIGIN=
# Set by CI on deploy.
COMMIT_HASH=

# ── Theme & i18n ─────────────────────────────────────────────────────────────
DEFAULT_THEME_MODE=dark
NEXT_PUBLIC_DEFAULT_THEME_MODE=dark
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ORGANIZATION_SAME_AS=

# ── Auth & JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=15724800
# Derives the key that encrypts TOTP secrets. Regenerating it invalidates every enrolled MFA.
MFA_ENCRYPTION_KEY=
FIRST_ADMIN_LOGIN=
FIRST_ADMIN_PASSWORD=

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Either a full MONGO_URI (external cluster) or the fields below (local container: host `mongo`,
# never localhost; the container always has a root user — set MONGO_USER/MONGO_PASSWORD).
MONGO_URI=
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=app

# ── Redis & rate limit ───────────────────────────────────────────────────────
# Local: port from docker-compose.dev.yml. On a server with redis_enabled: redis://redis:6379.
REDIS_URL=redis://localhost:6380
RATE_LIMIT_POINTS=100

# ── Background worker (jobs inside the optional worker container) ────────────
WORKER_HEARTBEAT=false
WORKER_HEARTBEAT_INTERVAL_MS=300000

# ── Registration & email ─────────────────────────────────────────────────────
# REGISTRATION_MODE: `email` (OTP to mailbox) or empty (no verification).
REGISTRATION_MODE=email
REGISTRATION_CODE_PEPPER=
# EMAIL_SEND_MODE: console | elastic | empty
EMAIL_SEND_MODE=console
EMAIL_API_KEY=
EMAIL_FROM="Noreply <noreply@localhost>"
EMAIL_REPLY_TO=
EMAIL_TEMPLATE_VERIFY_EMAIL_EN="EN: Verify Email"
EMAIL_TEMPLATE_VERIFY_EMAIL_RU="RU: Verify Email"
EMAIL_TEMPLATE_PASSWORD_CHANGE_EN=
EMAIL_TEMPLATE_PASSWORD_CHANGE_RU=
EMAIL_TEMPLATE_PASSWORD_FORGOT_EN=
EMAIL_TEMPLATE_PASSWORD_FORGOT_RU=

# ── Account security & onboarding (0 = off, 1 = on) ──────────────────────────
AUTH_PASSWORD_CHANGE_ENABLED=1
AUTH_PASSWORD_FORGOT_ENABLED=1
AUTH_RECOVERY_STRICTNESS=strict
AUTH_ADMIN_ACCOUNT_RECOVERY_ENABLED=1
AUTH_SESSIONS_ENABLED=0
ONBOARDING_VERSION=1
ONBOARDING_ENABLED=0
ONBOARDING_PUSH_PROMPT_ENABLED=0
NEXT_PUBLIC_ONBOARDING_ENABLED=0
NEXT_PUBLIC_ONBOARDING_PUSH_PROMPT_ENABLED=0
NEXT_PUBLIC_PUSH_IOS_PWA_HINT_ENABLED=0

# ── OAuth / social login ─────────────────────────────────────────────────────
# A provider needs all three: its name in the lists, AUTH_OAUTH_<X>_ENABLED=1, client id/secret.
# Lists are comma-separated (yandex,google,github,vk,discord) on their own line: no inline comments.
AUTH_UI_MODE=credentials_only
NEXT_PUBLIC_AUTH_UI_MODE=credentials_only
AUTH_OAUTH_SIGN_IN_PROVIDERS=
AUTH_OAUTH_SIGN_UP_PROVIDERS=
AUTH_OAUTH_LINK_PROVIDERS=
NEXT_PUBLIC_AUTH_OAUTH_SIGN_IN_PROVIDERS=
NEXT_PUBLIC_AUTH_OAUTH_SIGN_UP_PROVIDERS=
NEXT_PUBLIC_AUTH_OAUTH_LINK_PROVIDERS=
AUTH_OAUTH_YANDEX_ENABLED=0
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_ENABLED=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_ENABLED=0
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_VK_ENABLED=0
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
AUTH_OAUTH_DISCORD_ENABLED=0
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
VAPID_SUBJECT="mailto:your-email@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Notifications (channels: all | web_push | email, comma-separated) ────────
NOTIFY_ARTICLE_ENABLED=1
NOTIFY_ARTICLE_CHANNELS=all
NOTIFY_MFA_ENABLED=1
NOTIFY_MFA_CHANNELS=all
NOTIFY_LOGIN_ENABLED=1
NOTIFY_LOGIN_CHANNELS=email
NOTIFY_PASSWORD_ENABLED=1
NOTIFY_PASSWORD_CHANNELS=email

# ── LLM (OpenAI, server-side key) ────────────────────────────────────────────
NEXT_PUBLIC_LLM_ENABLED=false
LLM_API_KEY=
LLM_CHAT_MODELS=gpt-4o-mini,gpt-4o
LLM_IMAGE_MODELS=gpt-image-1-mini,gpt-image-1.5
LLM_CHAT_RATE_LIMIT_POINTS=30
LLM_CHAT_RATE_DURATION_SEC=60
# JSON array of "host:port:user:password[:geo]"; one entry is picked per request.
PROXY_ACCESSES=

# ── SEO & indexing ───────────────────────────────────────────────────────────
INDEXNOW_API_KEY=
INDEXNOW_KEY_LOCATION=
GOOGLE_INDEXING_CLIENT_EMAIL=
GOOGLE_INDEXING_PRIVATE_KEY=
# Protects /api/v1/seo/* with header x-seo-notify-secret once enabled.
SEO_NOTIFY_AUTH_ENABLED=false
SEO_NOTIFY_SECRET=

# ── RUM (Web Vitals) ─────────────────────────────────────────────────────────
RUM_ENABLED=true
NEXT_PUBLIC_RUM_ENABLED=true
NEXT_PUBLIC_RUM_SAMPLE_RATE=0.2
# Dev only: skip the cookie banner and auto-allow RUM.
NEXT_PUBLIC_SKIP_ANALYTICS_CONSENT=false

# ── CDN (Uploadcare) ─────────────────────────────────────────────────────────
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=

# ── Machine access: API tokens + MCP ─────────────────────────────────────────
API_TOKENS_ENABLED=0
NEXT_PUBLIC_API_TOKENS_ENABLED=0
MCP_SERVER_NAME=nsb-mcp
# Brand for token prefixes (<brand>_pat_…). Set once: changing it breaks issued tokens.
NEXT_PUBLIC_API_TOKEN_BRAND=nsb
MCP_OAUTH_ENABLED=0
MCP_OAUTH_ACCESS_TTL_MINUTES=60
MCP_OAUTH_CLIENT_RETENTION_DAYS=30
# Set before the first deploy: changing it later requires dropping the TTL index.
API_TOKEN_USAGE_RETENTION_DAYS=30
