new file mode 100644
index 0000000..14aa03a
--- /dev/null
+++ b/pnpm-workspace.yaml
@@ -0,0 +1,15 @@
+# pnpm 10.16+/11 читает настройки отсюда (в package.json поле "pnpm" в новых версиях игнорируется).
+# overrides форсят безопасные версии транзитивных зависимостей (см. SECURITY_SEO_AUDIT.md).
+# Версионно-скоупленные селекторы (picomatch/ws/brace-expansion) правят только уязвимые ветки,
+# не трогая места, где в дереве нужна другая мажорная версия.
+overrides:
+  dompurify: '>=3.4.11'
+  happy-dom: '>=20.8.9'
+  markdown-it: '>=14.2.0'
+  linkify-it: '>=5.0.1'
+  postcss: '>=8.5.10'
+  '@babel/core': '>=7.29.6'
+  'picomatch@>=4.0.0 <4.0.4': '>=4.0.4'
+  'ws@>=7.0.0 <7.5.11': '>=7.5.11'
+  'brace-expansion@>=1.0.0 <1.1.13': 1.1.13
+  'brace-expansion@>=4.0.0 <5.0.6': 5.0.6
