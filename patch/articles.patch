+            item.isCurrent
+              ? 'border-primary bg-primary text-primary-foreground pointer-events-none'
+              : 'border-border bg-muted/50 text-foreground hover:bg-muted',
+          )}
+        >
+          {item.hreflangKey}
+        </a>
+      ))}
+    </nav>
+  )
+}
