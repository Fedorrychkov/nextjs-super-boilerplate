diff --git a/.docker/nginx/nginx.conf.template.http b/.docker/nginx/nginx.conf.template.http
index 5bfdba0..185c37d 100644
--- a/.docker/nginx/nginx.conf.template.http
+++ b/.docker/nginx/nginx.conf.template.http
@@ -37,9 +37,8 @@ http {
     resolver 127.0.0.11 valid=10s ipv6=off;
 
     # METRICS_GRAFANA_UPSTREAM_START
-    upstream grafana {
-        server grafana:3000;
-    }
+    # (markers kept for the METRICS_ENABLED sed; grafana proxied via resolver+variable
+    # below, so a recreated grafana container doesn't leave nginx on a stale IP)
     # METRICS_GRAFANA_UPSTREAM_END
 
     # real_ip settings
@@ -104,7 +103,9 @@ http {
         # Proxy Grafana (subpath /grafana/)
         location /grafana/ {
             access_log off;
-            proxy_pass http://grafana/grafana/;
+            # variable -> nginx re-resolves via 127.0.0.11; URI passed through unchanged
+            set $grafana_upstream http://grafana:3000;
+            proxy_pass $grafana_upstream;
             proxy_http_version 1.1;
             proxy_set_header Host $host;
             proxy_set_header X-Real-IP $remote_addr;
diff --git a/.docker/nginx/nginx.conf.template.https b/.docker/nginx/nginx.conf.template.https
