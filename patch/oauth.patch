+  registry.ts                          # реестр провайдеров
+  oauth-flow.service.ts              # start/callback signIn|signUp
+  oauth-link.service.ts              # link/unlink/list
+  oauth-collision.service.ts         # логирование, политики
+  providers/
+    yandex.provider.ts
