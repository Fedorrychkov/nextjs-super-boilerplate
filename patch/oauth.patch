+'use client'
+
+import Link from 'next/link'
+
+import type { OAuthAttemptItemModel } from '~/api/oauth/types'
+import { Button, Typography } from '~/components/ui'
+import { OAUTH_PROVIDER_LABELS } from '~/lib/auth/oauth-public-config'
