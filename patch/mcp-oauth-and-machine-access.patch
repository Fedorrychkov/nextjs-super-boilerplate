+| 'mcp_oauth_client_registered' | 'mcp_oauth_consent_granted' | 'mcp_oauth_consent_denied'
+| 'mcp_oauth_tokens_issued' | 'mcp_oauth_grant_revoked'
+| 'machine_access_blocked' | 'machine_access_unblocked'
